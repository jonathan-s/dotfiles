#!/bin/sh
# Link the dotfiles in home/ into $HOME.
#
# Application-specific settings under macos/ are not installed by this script.

set -eu

repo=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
src="$repo/home"
mode='link'

usage() {
	cat <<'EOF'
Usage: ./bootstrap [--dry-run | --verify | --report]

  (no flags)  link everything, backing up any file it has to replace
  --dry-run   print what would happen, change nothing
  --verify    report links that are missing or point somewhere else
  --report    everything that is out of sync: links, shadowing files,
              uncommitted repo changes and macOS defaults drift
  -h, --help  show this message
EOF
}

for arg in "$@"; do
	case $arg in
		-n | --dry-run) mode=dry-run ;;
		--verify) mode=verify ;;
		--report) mode=report ;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			echo "bootstrap: unknown option: $arg" >&2
			usage >&2
			exit 2
			;;
	esac
done

[ -d "$src" ] || {
	echo "bootstrap: missing directory: $src" >&2
	exit 1
}

backup="$HOME/.dotfiles-backup-$(date +%Y%m%d-%H%M%S)"
list=$(mktemp)
trap 'rm -f "$list"' EXIT INT TERM

# Versioned commit hooks, so the credential guard travels with the repo.
# Only in link mode: --report and --verify are read-only.
if [ "$mode" = link ] && [ -d "$repo/.git" ] && [ -d "$repo/.githooks" ]; then
	git -C "$repo" config core.hooksPath .githooks
fi

# Dotfiles only; .DS_Store files are noise and stay out of the way.
find "$src" -name .DS_Store -prune -o -type f -print > "$list"

report_status=0

report_problem() {
	report_status=1
}

run_report() {
	report_links
	report_git
	report_macos
	if [ "$report_status" -eq 0 ]; then
		echo "bootstrap: everything in sync"
	else
		echo "bootstrap: out of sync (see above)" >&2
	fi
}

report_links() {
	echo "links"
	good=0
	bad=0
	shadow=0
	while IFS= read -r file; do
		rel=${file#"$src"/}
		target="$HOME/$rel"
		if [ -L "$target" ] && [ "$(readlink "$target")" = "$file" ]; then
			good=$((good + 1))
		elif [ -L "$target" ]; then
			echo "  wrong target: ~/$rel -> $(readlink "$target")"
			bad=$((bad + 1))
			report_problem
		elif [ -e "$target" ]; then
			echo "  shadowed by a real file: ~/$rel"
			shadow=$((shadow + 1))
			report_problem
		else
			echo "  missing: ~/$rel"
			bad=$((bad + 1))
			report_problem
		fi
	done < "$list"

	# Links into the repo whose source is gone (pruned files).
	for candidate in "$HOME"/.[!.]* "$HOME"/.config/* "$HOME"/.config/*/*; do
		[ -L "$candidate" ] || continue
		link=$(readlink "$candidate")
		case $link in
			"$src"/*) ;;
			*) continue ;;
		esac
		[ -e "$link" ] && continue
		echo "  dangling: ~/${candidate#"$HOME"/}"
		bad=$((bad + 1))
		report_problem
	done
	printf '  %d correct, %d wrong or missing, %d shadowed\n' "$good" "$bad" "$shadow"
}

report_git() {
	[ -d "$repo/.git" ] || return 0
	echo "repository"
	dirty=$(git -C "$repo" status --porcelain | wc -l | tr -d ' ')
	if [ "$dirty" -eq 0 ]; then
		echo "  working tree clean"
	else
		echo "  $dirty uncommitted path(s) — edits to symlinked files land here:"
		git -C "$repo" status --porcelain | head -10 | sed 's/^/    /'
		[ "$dirty" -le 10 ] || echo "    …"
		report_problem
	fi
	if [ -d "$repo/.githooks" ]; then
		hooks=$(git -C "$repo" config --get core.hooksPath || true)
		if [ "$hooks" != ".githooks" ]; then
			echo "  core.hooksPath is ${hooks:-unset}, want .githooks"
			report_problem
		fi
	fi
}

report_macos() {
	[ "$(uname -s)" = Darwin ] || return 0
	[ -x "$repo/macos/defaults.sh" ] || return 0
	[ "${DOTFILES_SKIP_MACOS:-0}" = 1 ] && return 0
	echo "macOS defaults"
	out=$("$repo/macos/defaults.sh" --check 2>&1) || true
	if printf '%s\n' "$out" | grep -q 'no drift'; then
		echo "  no drift"
		return 0
	fi
	printf '%s\n' "$out" | sed 's/^/  /'
	report_problem
}

if [ "$mode" = report ]; then
	run_report
	exit "$report_status"
fi

ok=0
changed=0
missing=0
pruned=0
blocked=0

# Check destinations before linking anything, so a bad path cannot leave a
# half-linked home directory behind.
if [ "$mode" = link ]; then
	while IFS= read -r file; do
		rel=${file#"$src"/}
		# Walk every existing ancestor: a file in the middle of the path
		# breaks mkdir -p just as badly as a file at the leaf.
		dir=$(dirname -- "$HOME/$rel")
		while [ "$dir" != "$HOME" ] && [ "$dir" != "/" ]; do
			if [ -e "$dir" ] && [ ! -d "$dir" ]; then
				echo "bootstrap: cannot link ~/$rel: $dir is not a directory" >&2
				blocked=$((blocked + 1))
				break
			fi
			dir=$(dirname -- "$dir")
		done
	done < "$list"
	if [ "$blocked" -gt 0 ]; then
		echo "bootstrap: $blocked destination(s) blocked, nothing was changed" >&2
		exit 1
	fi
fi

while IFS= read -r file; do
	rel=${file#"$src"/}
	target="$HOME/$rel"

	if [ -L "$target" ] && [ "$(readlink "$target")" = "$file" ]; then
		ok=$((ok + 1))
		continue
	fi

	if [ "$mode" = verify ]; then
		if [ -L "$target" ]; then
			echo "wrong target: ~/$rel -> $(readlink "$target")"
		elif [ -e "$target" ]; then
			echo "not a link:   ~/$rel"
		else
			echo "missing:      ~/$rel"
		fi
		missing=$((missing + 1))
		continue
	fi

	if [ "$mode" = dry-run ]; then
		if [ -e "$target" ] || [ -L "$target" ]; then
			echo "replace: ~/$rel"
		else
			echo "link:    ~/$rel"
		fi
		changed=$((changed + 1))
		continue
	fi

	if [ -e "$target" ] || [ -L "$target" ]; then
		mkdir -p "$backup/$(dirname "$rel")"
		mv "$target" "$backup/$rel"
	fi

	mkdir -p "$(dirname "$target")"
	ln -s "$file" "$target"
	changed=$((changed + 1))
done < "$list"

# Links whose file has left the repository would linger as dangling symlinks.
for candidate in "$HOME"/.[!.]* "$HOME"/.config/* "$HOME"/.config/*/*; do
	[ -L "$candidate" ] || continue
	link=$(readlink "$candidate")
	case $link in
		"$src"/*) ;;
		*) continue ;;
	esac
	[ -e "$link" ] && continue
	if [ "$mode" = verify ]; then
		echo "dangling:     ~/${candidate#"$HOME"/} (file is gone from the repo)"
		missing=$((missing + 1))
		continue
	fi
	[ "$mode" = dry-run ] || rm "$candidate"
	echo "prune:   ~/${candidate#"$HOME"/} (file is gone from the repo)"
	pruned=$((pruned + 1))
done

# macOS preferences, on Macs only. Stamped per module, so this is a no-op
# unless one of the modules changed since the last successful apply.
macos_status=0
if [ "$mode" = link ] && [ "${DOTFILES_SKIP_MACOS:-0}" != 1 ] && [ -x "$repo/macos/defaults.sh" ]; then
	case $(uname -s) in
		Darwin)
			"$repo/macos/defaults.sh" --quiet || {
				echo "bootstrap: macos/defaults.sh failed" >&2
				macos_status=1
			}
			;;
	esac
fi

case $mode in
	verify)
		if [ "$missing" -eq 0 ]; then
			echo "all $ok links are correct"
		else
			echo "$missing link(s) need attention, $ok are correct" >&2
			exit 1
		fi
		;;
	dry-run)
		echo "would change $changed link(s) and prune $pruned, $ok already correct"
		;;
	link)
		echo "linked $changed file(s), pruned $pruned, $ok already correct"
		[ "$changed" -eq 0 ] || echo "previous files (if any) moved to $backup"
		;;
esac

[ "$macos_status" -eq 0 ] || exit 1
