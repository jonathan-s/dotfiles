# Repo-level ignores; $HOME-wide ignores live in home/.config/git/ignore.

# Working notes that should not be shared.
plans/

# Python
*.pyc
__pycache__/
venv/

# macOS
.DS_Store
._*

# Machine values. The tracked example is the contract; the real file is local.
ubuntu/hosts/*.sh
!ubuntu/hosts/*.example.sh
