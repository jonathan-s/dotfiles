# macOS-only surface: casks, editor extensions, Mac App Store apps, and the
# formulae that are `depends_on :macos` or shadowed by the system. Never
# installed on Linux.
tap "bramstein/webfonttools"
tap "homebrew/core"
tap "homebrew/services"
tap "gromgit/fuse"
tap "homebrew/cask"

# Mac App Store command-line interface
brew "mas"
# OpenBSD freely-licensed SSH connectivity tools
brew "openssh"
# CLI tool that moves files or folder to the trash
brew "trash"
# FUSE file system for mounting to another location
brew "gromgit/fuse/bindfs-mac", trusted: true
# Application launcher and productivity software
cask "alfred"
# Toolset to implement parts of Android apps in native code
cask "android-ndk"
# Android SDK component
cask "android-platform-tools"
# Tools for building Android applications
cask "android-studio"
# Hard disk backup and cloning utility
cask "carbon-copy-cloner"
# PDF file editor
cask "combine-pdfs"
# Universal database tool and SQL client
cask "dbeaver-community"
# Voice and text chat software
cask "discord"
# Disk usage utility
cask "disk-inventory-x"
cask "exodus"
# Web browser
cask "firefox@developer-edition"
# Screen colour temperature controller
cask "flux-app"
cask "font-fira-code-nerd-font"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Open-source video transcoder
cask "handbrake-app"
# Tool to run Windows games
cask "highball"
# Open-source screen recorder built with web technology
cask "kap"
# Free and open-source office suite
cask "libreoffice"
# Host-based application firewall
cask "little-snitch"
# Knowledge base that works on top of a local folder of plain text Markdown files
cask "obsidian"
# App wrapper for Postgres
cask "postgres-app"
# GUI client for PostgreSQL databases
cask "postico"
# Move and resize windows using keyboard shortcuts or snap areas
cask "rectangle"
# Block your own access to distracting websites
cask "selfcontrol"
# Instant messaging application focusing on security
cask "signal"
# PDF reader and note-taking application
cask "skim"
# Team communication and collaboration software
cask "slack"
# System monitor for the menu bar
cask "stats"
# Video game digital distribution service
cask "steam"
# Messaging app with a focus on speed and security
cask "telegram"
# Open-source BitTorrent client
cask "transmission"
# Free and open-source OpenVPN client
cask "tunnelblick"
# Multimedia player
cask "vlc"
# Torrent streaming application
cask "webtorrent"
# Video communication and virtual meeting platform
cask "zoom"
